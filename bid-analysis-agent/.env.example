# Copy this file to app/.env and fill in the REQUIRED variables below.
# The app/ subdirectory is where ADK (adk web / agents-cli playground) looks for .env.

# --- Vertex AI (REQUIRED for agents-cli playground / adk web) ----------------
# These are set programmatically by configure_vertex_ai() when running via
# fast_api_app.py (Docker), but must be present in app/.env for local dev.

# Your GCP project ID (run: gcloud config get-value project)
# For local dev use your default project; for Agent Space deploy use: bid-agent-496709
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Use "global" — NOT "us-central1" — for gemini-3-flash-preview to avoid 404s.
GOOGLE_CLOUD_LOCATION=global

# Switch the Gemini SDK to route through Vertex AI instead of Gemini API.
GOOGLE_GENAI_USE_VERTEXAI=True

# --- Telemetry (Google Cloud) -------------------------------------------------

# GCS bucket for ADK artifacts and (optionally) GenAI prompt/response logs.
# Leave unset to use InMemoryArtifactService (no GCS dependency).
# LOGS_BUCKET_NAME=

# Enable GenAI message-content capture in OpenTelemetry traces.
# When LOGS_BUCKET_NAME is set AND this is not "false", telemetry.py forces
# NO_CONTENT mode (metadata only, no prompts/responses) — privacy by default.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Sub-path inside LOGS_BUCKET_NAME for GenAI completion uploads.
# GENAI_TELEMETRY_PATH=completions

# --- Service metadata ---------------------------------------------------------

# Git SHA, tagged in OTel resource attributes. Injected by Docker build.
# COMMIT_SHA=dev

# Agent version, surfaced in the A2A AgentCard.
# AGENT_VERSION=0.1.0

# Public URL of the service (used to build the A2A rpc_url in the AgentCard).
# Change for Cloud Run / remote deploys.
# APP_URL=http://0.0.0.0:8080

# --- Agent Space deploy (project: bid-agent-496709) ---------------------------
# These are used by `agents-cli deploy` when deploying to Vertex AI Agent Engine.
# GOOGLE_CLOUD_PROJECT=bid-agent-496709
# GOOGLE_CLOUD_LOCATION=us-central1
